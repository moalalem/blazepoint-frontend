# ============================================
# Frontend Environment Variables
# ============================================
# انسخ هذا الملف إلى .env للاستخدام المحلي:
# cp .env.example .env
#
# ⚠️ لا ترفع .env أبداً على GitHub!

# ============================================
# API Configuration
# ============================================
# API URL (يختلف حسب البيئة)
# التطوير: http://localhost:5000/api
# الإنتاج: https://your-backend.up.railway.app/api
VITE_API_URL=http://localhost:5000/api

# ============================================
# Optional (للمستقبل)
# ============================================
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=